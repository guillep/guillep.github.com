---
import { readFile } from "node:fs/promises";
import path from "node:path";
import { parse, type Entry } from "@retorquere/bibtex-parser";
import PublicationEntry from "./PublicationEntry.astro";

interface Props {
  bibFile: string;
  id?: string;
  title?: string;
  filter: "all" | "top-conferences" | "conferences" | "journals" | "workshops" | "others";
  search?: boolean;
  compact?: boolean;
  sort?: "year" | "alphabetical";
}

const {
  bibFile,
  id: providedId,
  title,
  filter,
  search = true,
  compact = false,
  sort = "year",
} = Astro.props;
const id =
  providedId ??
  title?.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") ??
  `bibliography-${filter}`;
const bibPath = path.resolve(process.cwd(), bibFile);
const bibContents = await readFile(bibPath, "utf8");
const { entries: parsedEntries, errors } = parse(bibContents, { english: false });

if (errors.length > 0) {
  console.warn(`BibTeX parser reported ${errors.length} issue(s) in ${bibFile}.`);
}

type Publication = Entry & {
  year: number;
  numericYear: number;
  rankOrder: number;
  category: PublicationCategory;
};
type PublicationCategory = "top-conferences" | "conferences" | "journals" | "workshops" | "others";

function compareByYear(a: Publication, b: Publication): number {
  return (
    b.numericYear - a.numericYear ||
    a.rankOrder - b.rankOrder ||
    a.fields.title.localeCompare(b.fields.title, undefined, { sensitivity: "base" })
  );
}

function compareAlphabetically(a: Publication, b: Publication): number {
  return a.fields.title.localeCompare(b.fields.title, undefined, { sensitivity: "base" });
}

function isTopConference(entry: Entry): boolean {
  return (
    entry.type === "inproceedings" &&
    Boolean(field(entry, "rank"))
  );
}

function isPoster(entry: Entry): boolean {
  const marker = `${field(entry, "annote") ?? ""} ${field(entry, "type") ?? ""}`;
  return /poster/i.test(marker);
}

function isWorkshop(entry: Entry): boolean {
  if (field(entry, "venue-type")?.toLowerCase() === "workshop") return true;
  const venueName = `${field(entry, "booktitle") ?? ""} ${field(entry, "annote") ?? ""}`;
  return /workshop|\biwst\b|\bfast\b/i.test(venueName);
}

function categoryFor(entry: Entry): PublicationCategory {
  if (isPoster(entry)) return "others";
  if (isTopConference(entry)) return "top-conferences";
  if (entry.type === "article") return "journals";
  if (entry.type === "inproceedings") return isWorkshop(entry) ? "workshops" : "conferences";
  return "others";
}

const entries: Publication[] = parsedEntries
  .filter((entry) => entry.fields.title && entry.fields.year)
  .map((entry) => {
    const numericYear = Number.parseInt(entry.fields.year, 10);
    return {
      ...entry,
      numericYear,
      year: Number.isFinite(numericYear) ? numericYear : 0,
      rankOrder: entry.fields.rank === "A*" ? 0 : entry.fields.rank === "A" ? 1 : 2,
      category: categoryFor(entry),
    };
  })
  .filter((entry) => entry.year > 0)
  .sort(sort === "alphabetical" ? compareAlphabetically : compareByYear);

const categoriesWithEntries = new Set(entries.map((entry) => entry.category));
const categoryOptions: { value: PublicationCategory; label: string }[] = [
  { value: "top-conferences", label: "Top conferences" },
  { value: "conferences", label: "Conferences" },
  { value: "journals", label: "Journals" },
  { value: "workshops", label: "Workshops" },
  { value: "others", label: "Others" },
];

function matchesFilter(entry: Publication): boolean {
  switch (filter) {
    case "all":
      return true;
    case "top-conferences":
      return entry.category === "top-conferences";
    case "conferences":
      return (
        entry.type === "inproceedings" &&
        !isPoster(entry) &&
        !isWorkshop(entry) &&
        !isTopConference(entry)
      );
    case "journals":
      return entry.category === "journals";
    case "workshops":
      return entry.category === "workshops";
    case "others":
      return entry.category === "others";
  }
}

const filteredEntries = entries.filter(matchesFilter);
const visibleEntries = filter === "all" ? entries : filteredEntries;

const typeLabels: Record<string, string> = {
  article: "Journal article",
  booklet: "Booklet",
  inproceedings: "Conference paper",
  misc: "Other publication",
  phdthesis: "PhD thesis",
  techreport: "Technical report",
};

function field(entry: Entry, name: string): string | undefined {
  const value = entry.fields[name.toLowerCase()];
  return typeof value === "string" ? value : undefined;
}

function authorName(author: { firstName?: string; lastName?: string }): string {
  return [author.firstName, author.lastName].filter(Boolean).join(" ");
}

function safeLink(value: string | undefined): string | undefined {
  if (!value) return undefined;

  try {
    const url = new URL(value);
    return url.protocol === "http:" || url.protocol === "https:"
      ? url.toString()
      : undefined;
  } catch {
    return undefined;
  }
}

function doiLink(value: string | undefined): string | undefined {
  if (!value) return undefined;
  const doi = value.replace(/^https?:\/\/(doi\.org\/)?/i, "");
  return safeLink(`https://doi.org/${doi}`);
}

function venue(entry: Entry): string | undefined {
  const venueName =
    field(entry, "journal") ??
    field(entry, "booktitle") ??
    field(entry, "institution") ??
    field(entry, "school") ??
    field(entry, "publisher");
  const volume = field(entry, "volume");
  const pages = field(entry, "pages");

  return [venueName, volume && `vol. ${volume}`, pages && `pp. ${pages}`]
    .filter(Boolean)
    .join(", ");
}

function searchText(entry: Entry): string {
  const authors = entry.fields.author?.map(authorName).join(" ") ?? "";
  return [entry.fields.title, authors, venue(entry), field(entry, "keywords")]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
}
---

<section
  id={id}
  class:list={["bibliography", compact && "compact"]}
  data-filter={filter}
  data-sort={sort}
  aria-labelledby={title ? `${id}-title` : undefined}
  aria-label={title ? undefined : "Publications"}
>
  {title && <h2 id={`${id}-title`} class="category-heading">{title}</h2>}
  {
    search && (
      <>
        <input
          id={`${id}-search`}
          class="search-input"
          type="search"
          placeholder="Search titles, authors, venues…"
          autocomplete="off"
          data-publication-search
        />
      </>
    )
  }
  {filter === "all" && (
    <div class="bibliography-controls">
      <fieldset class="type-filters" data-type-filters>
        <legend class="sr-only">Filter by type</legend>
        {categoryOptions.map((option) => (
          <label>
            <input
              type="checkbox"
              value={option.value}
              data-category-filter={option.value}
              checked
              disabled={!categoriesWithEntries.has(option.value)}
            />
            {option.label}
          </label>
        ))}
      </fieldset>
      <label class="sort-control">
        Sort by
        <select data-publication-sort value={sort}>
          <option value="year">Year (newest first)</option>
          <option value="alphabetical">Alphabetical</option>
        </select>
      </label>
    </div>
  )}
  <p class="result-count" aria-live="polite">
    <span data-result-count>{visibleEntries.length}</span> publications
  </p>

  <ol class="publication-list" data-publication-list>
    {visibleEntries.map((entry) => (
      <PublicationEntry
        entry={entry}
        category={entry.category}
        searchable={searchText(entry)}
        compact={compact}
      />
    ))}
  </ol>

  <p class="empty-state" hidden>No publications match your search.</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".bibliography").forEach((bibliography) => {
    const searchInput = bibliography.querySelector<HTMLInputElement>("[data-publication-search]");
    const publicationItems = Array.from(
      bibliography.querySelectorAll<HTMLElement>(".publication[data-searchable]")
    );
    const categoryFilters = Array.from(
      bibliography.querySelectorAll<HTMLInputElement>("[data-category-filter]")
    );
    const sortSelect = bibliography.querySelector<HTMLSelectElement>("[data-publication-sort]");
    const publicationList = bibliography.querySelector<HTMLOListElement>("[data-publication-list]");
    const resultCount = bibliography.querySelector<HTMLElement>("[data-result-count]");
    const emptyState = bibliography.querySelector<HTMLElement>(".empty-state");

    const updateFilters = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? "";
      let visibleCount = 0;

      const selectedCategories = categoryFilters
        .filter((checkbox) => checkbox.checked)
        .map((checkbox) => checkbox.value);
      const sortMode = sortSelect?.value ?? bibliography.dataset.sort ?? "year";
      const shouldFilterByCategory = bibliography.dataset.filter === "all";

      const sortedItems = [...publicationItems].sort((a, b) => {
        if (sortMode === "alphabetical") {
          return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "", undefined, {
            sensitivity: "base",
          });
        }
        return (
          Number(b.dataset.year) - Number(a.dataset.year) ||
          Number(a.dataset.rankOrder ?? 2) - Number(b.dataset.rankOrder ?? 2) ||
          (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "", undefined, {
            sensitivity: "base",
          })
        );
      });
      sortedItems.forEach((publication) => {
        publicationList?.append(publication);
      });

      for (const publication of publicationItems) {
        const matchesSearch = publication.dataset.searchable?.includes(query) ?? false;
        const matchesCategory =
          !shouldFilterByCategory ||
          categoryFilters.length === 0 ||
          selectedCategories.includes(publication.dataset.category ?? "");
        const matches = matchesSearch && matchesCategory;
        publication.hidden = !matches;
        if (matches) visibleCount += 1;
      }

      if (resultCount) resultCount.textContent = String(visibleCount);
      if (emptyState) emptyState.hidden = visibleCount > 0;
    };

    searchInput?.addEventListener("input", updateFilters);
    categoryFilters.forEach((checkbox) => checkbox.addEventListener("change", updateFilters));
    sortSelect?.addEventListener("change", updateFilters);
    updateFilters();
  });
</script>

<style>
  .bibliography {
    @apply mb-8;
  }

  .search-input {
    @apply w-full rounded border border-current bg-transparent px-3 py-2;
  }

  .result-count {
    @apply mt-2 text-sm text-text-muted;
  }

  .bibliography-controls {
    @apply my-4 flex flex-wrap items-center justify-between gap-3;
  }

  .type-filters {
    @apply flex flex-wrap items-center gap-x-4 gap-y-2 border-0 p-0;
  }

  .type-filters label {
    @apply flex cursor-pointer items-center gap-1.5 text-sm;
  }

  .type-filters input {
    @apply accent-text-link;
  }

  .sort-control {
    @apply ml-auto flex shrink-0 items-center gap-2 text-sm;
  }

  .sort-control select {
    @apply rounded border border-current bg-transparent px-2 py-1;
  }

  .year-heading {
    @apply mt-4 mb-3 text-lg font-bold text-text-muted;
  }

  .category-heading {
    @apply mt-10 mb-5 border-b border-current pb-2 text-2xl font-bold;
  }

  .publication-list {
    @apply list-none p-0 m-0;
  }

  .publication {
    @apply mb-5 border-b border-current pb-0;
    border-color: color-mix(in srgb, currentColor 20%, transparent);
  }

  .bibliography.compact :global(.category-heading) {
    @apply mt-6 mb-3 border-0 pb-0 text-xl;
  }

  .bibliography.compact :global(.result-count) {
    display: none;
  }

  .bibliography.compact :global(.year-heading) {
    @apply mt-3 mb-2 text-sm;
  }

  .bibliography.compact :global(.publication) {
    @apply mb-2 border-0 p-0;
  }

  .publication-year {
    display: none;
  }

  .bibliography.compact :global(.year-heading) {
    display: none;
  }

  .bibliography.compact :global(.publication-title) {
    @apply text-sm text-inherit;
  }

  .bibliography.compact :global(.authors) {
    @apply mb-0 mt-0 inline text-sm font-normal not-italic text-inherit;
  }

  .bibliography.compact :global(.venue) {
    @apply mb-0 mt-0 inline text-sm font-normal not-italic;
  }

  .bibliography.compact :global(.authors),
  .bibliography.compact :global(.venue) {
    @apply whitespace-normal;
  }

  .bibliography.compact :global(.authors)::after {
    content: ", ";
  }

  .bibliography.compact :global(.publication-links a) {
    @apply whitespace-nowrap;
  }

  .bibliography.compact :global(a:hover) {
    color: inherit;
  }

  .bibliography.compact :global(.publication-links a:first-child)::before {
    content: " ";
  }

  .type-label {
    @apply text-text-muted;
  }

  .abstract-details {
    @apply mt-2 text-sm;
  }

  .abstract-details summary {
    @apply w-fit cursor-pointer text-text-muted hover:text-text-link;
  }

  .abstract-details p {
    @apply mt-2 mb-0;
  }

  .empty-state {
    @apply mt-8 text-text-muted;
  }
</style>
