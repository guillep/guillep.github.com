---
import { read } from "../lib/markdoc/read";
import { z } from "zod";
import PageMeta from "../components/PageMeta.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Renderer from "../components/Renderer.astro";
import { SITE_TITLE } from "../config";

const { content } = await read({
  filepath: "./content/homepage.md",
  schema: z.object({}),
});
---

<PageLayout>
  <PageMeta title={`${SITE_TITLE} | Researcher @ Inria`} slot="meta" />
  <section slot="main" class="homepage-content mb-8">
    <Renderer content={content} headingBorders={false} />
  </section>
</PageLayout>

<style>
  .homepage-content :global(h1) {
    @apply block ml-0 font-bold uppercase text-center text-4xl md:text-5xl py-6 overflow-hidden;
  }

  .homepage-content :global(h1 > span:last-child) {
    @apply bg-gradient-to-br from-[#334155] via-[#1e293b] to-[#0f172a] dark:from-primary-main dark:via-primary-main dark:to-primary-main bg-clip-text text-transparent;
  }

  .homepage-content :global(p) {
    @apply mb-8;
  }

  .homepage-content :global(h1 + hr + p) {
    @apply mb-0 text-center;
  }

  .homepage-content :global(h1 + p a) {
    margin-left: 1rem;
    background-image: none;
  }

  .homepage-content :global(h1 + p a:hover) {
    @apply text-text-link;
  }

  .homepage-content :global(h2) {
    @apply text-2xl font-bold;
  }

</style>
