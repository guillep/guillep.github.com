---
import PageMeta from "../components/PageMeta.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Bibliography from "../components/Bibliography.astro";
import { SITE_TITLE } from "../config";
---

<PageLayout>
  <PageMeta title={`${SITE_TITLE} | Publications`} slot="meta" />
  <div slot="main">
    <Bibliography
      id="selected-articles"
      bibFile="public/mybib.bib"
      filter="top-conferences"
      title="Selected Articles"
      compact
      search={false}
    />
    <Bibliography
      id="all-publications"
      bibFile="public/mybib.bib"
      filter="all"
      title="Publications"
      search
      sort="year"
    />
  </div>
</PageLayout>
