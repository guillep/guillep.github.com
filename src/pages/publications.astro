---
import PageMeta from "../components/PageMeta.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Bibliography from "../components/Bibliography.astro";
import { SITE_TITLE } from "../config";
---

<PageLayout>
  <PageMeta title={`${SITE_TITLE} | Publications`} slot="meta" />
  <div slot="main">
    <Bibliography
      id="selected-articles"
      bibFile="public/mybib.bib"
      filter="top-conferences"
      title="Selected Articles"
      search={false}
    />
    <Bibliography
      id="conference-publications"
      bibFile="public/mybib.bib"
      filter="conferences"
      title="Conferences"
    />
    <Bibliography
      id="journal-publications"
      bibFile="public/mybib.bib"
      filter="journals"
      title="Journals"
    />
    <Bibliography
      id="workshop-publications"
      bibFile="public/mybib.bib"
      filter="workshops"
      title="Workshops"
    />
    <Bibliography
      id="other-publications"
      bibFile="public/mybib.bib"
      filter="others"
      title="Others"
    />
  </div>
</PageLayout>
